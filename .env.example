# Slack app running in Socket Mode
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# this will be provided through slack app
# 1. check with claude - ask to generate app manifest for new slack app,
# so that we can listen to all messages in the given slack channel

# Only react to alert messages posted by this app/bot (avoids loops on our own replies)
PAGERDUTY_BOT_NAME=PagerDuty

# Channel where PagerDuty posts triggered + resolved incidents (bot must be invited)
SLACK_ALERTS_CHANNEL_NAME=elg-pagerduty-alerts

# Datadog - created a new service account and got the keys
DATADOG_API_KEY=...
DATADOG_APP_KEY=...
DATADOG_SITE=datadoghq.com

# Claude
ANTHROPIC_API_KEY=...

# Internal debug-id lookup system
CAL_BASE_URL=https://cal.internal.example.com
CAL_API_KEY=...
